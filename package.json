{
  "name": "hexalith-timesheets",
  "version": "0.0.0",
  "private": true,
  "description": "Release and Conventional Commit tooling for Hexalith.Timesheets",
  "engines": {
    "node": ">=24.10.0"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "commitlint": "commitlint",
    "commitlint:last": "commitlint --from HEAD~1 --to HEAD",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "test:release-tooling": "python3 -m unittest discover -s scripts/tests -v",
    "postinstall": "node scripts/repair-release-tooling-bundles.mjs",
    "repair:release-tooling": "node scripts/repair-release-tooling-bundles.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "semantic-release": "25.0.9"
  }
}
