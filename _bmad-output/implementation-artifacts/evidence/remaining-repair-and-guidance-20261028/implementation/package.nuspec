    <readme>README.md</readme>
    <projectUrl>https://github.com/Hexalith/Hexalith.EventStore</projectUrl>
    <description>Multi-tenant client SDK for the Hexalith event store — domain processor registration, assembly scanning, and fluent configuration for .NET event sourcing with DAPR</description>
    <tags>eventsourcing dapr cqrs eventstore dotnet</tags>
    <repository type="git" url="https://github.com/Hexalith/Hexalith.EventStore" commit="717a06e16c3afd81b904eaf4de646b74b13262d2" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Hexalith.EventStore.Contracts" version="3.128.4" exclude="Build,Analyzers" />
        <dependency id="Dapr.Client" version="1.19.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNetCore.DataProtection.Abstractions" version="10.0.14" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration.Binder" version="10.0.14" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="10.0.14" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Http" version="10.0.14" exclude="Build,Analyzers" />
        <dependency id="ByteAether.Ulid" version="1.4.2" exclude="Build,Analyzers" />
        <dependency id="Hexalith.Commons.UniqueIds" version="2.30.3" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration" version="10.0.14" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration.Abstractions" version="10.0.14" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DependencyInjection" version="10.0.14" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.14" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Diagnostics.Abstractions" version="10.0.14" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Logging.Abstractions" version="10.0.14" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Options" version="10.0.14" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Options.ConfigurationExtensions" version="10.0.14" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>