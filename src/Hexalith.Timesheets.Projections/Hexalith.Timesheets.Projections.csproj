<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Timesheets rebuildable projection contracts and replay-safe helpers.</Description>
    <PackageTags>timesheets;projections;read-models;eventsourcing;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The projection event reader and the deterministic fold-failure marker stay internal to this
         assembly; the projection test project asserts their guards directly. -->
    <InternalsVisibleTo Include="Hexalith.Timesheets.Projections.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hexalith.Timesheets.Contracts\Hexalith.Timesheets.Contracts.csproj" />
    <ProjectReference Include="..\Hexalith.Timesheets.Server\Hexalith.Timesheets.Server.csproj" />
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Client\Hexalith.EventStore.Client.csproj" Condition="'$(UseHexalithProjectReferences)' == 'true'" />
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Contracts\Hexalith.EventStore.Contracts.csproj" Condition="'$(UseHexalithProjectReferences)' == 'true'" />
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.DomainService\Hexalith.EventStore.DomainService.csproj" Condition="'$(UseHexalithProjectReferences)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' != 'true'">
    <PackageReference Include="Hexalith.EventStore.Client" />
    <PackageReference Include="Hexalith.EventStore.Contracts" />
    <PackageReference Include="Hexalith.EventStore.DomainService" />
  </ItemGroup>
</Project>
