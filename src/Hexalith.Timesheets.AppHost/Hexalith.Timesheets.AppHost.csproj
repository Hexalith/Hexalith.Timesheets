<Project Sdk="Aspire.AppHost.Sdk/13.6.3">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(UseHexalithProjectReferences)' == 'true'">
    <DefineConstants>$(DefineConstants);TIMESHEETS_COMPILED_GATEWAY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(HexalithEventStoreRoot)/src/Hexalith.EventStore.Aspire/Hexalith.EventStore.Aspire.csproj" IsAspireProjectResource="false" Condition="'$(UseHexalithProjectReferences)' == 'true'" />
    <ProjectReference Include="$(HexalithEventStoreRoot)/src/Hexalith.EventStore/Hexalith.EventStore.csproj" ReferenceOutputAssembly="false" IsAspireProjectResource="false" Condition="'$(UseHexalithProjectReferences)' == 'true'" />
    <ProjectReference Include="..\Hexalith.Timesheets\Hexalith.Timesheets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="KeycloakRealms/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' != 'true'">
    <PackageReference Include="Hexalith.EventStore.Aspire" />
  </ItemGroup>
</Project>
