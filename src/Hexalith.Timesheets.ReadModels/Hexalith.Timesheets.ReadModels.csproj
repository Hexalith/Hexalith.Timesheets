<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Shared Timesheets read-model helpers and persisted EventStore payloads.</Description>
    <PackageTags>timesheets;read-models;eventsourcing;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hexalith.Timesheets.Contracts\Hexalith.Timesheets.Contracts.csproj" />
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Client\Hexalith.EventStore.Client.csproj" Condition="'$(UseHexalithProjectReferences)' == 'true'" />
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Contracts\Hexalith.EventStore.Contracts.csproj" Condition="'$(UseHexalithProjectReferences)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' != 'true'">
    <PackageReference Include="Hexalith.EventStore.Client" />
    <PackageReference Include="Hexalith.EventStore.Contracts" />
  </ItemGroup>
</Project>
